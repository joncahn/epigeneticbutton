def derive_label_from_filename(path):
    """Strip extension(s) from a basename to use as a default plot label.

    "/data/target_genes.txt" → "target_genes"
    "/data/regions.bed.gz"   → "regions"
    """
    name = Path(path).name
    while True:
        stem, ext = os.path.splitext(name)
        if not ext:
            break
        name = stem
    return name or "target"


def validate_output_input(input_path, fmt):
    """Lightweight format check on the user-provided input file.

    "tsv_geneids" : at least one non-comment line, first column non-empty.
    "bed"         : at least one non-comment line with ≥3 cols where
                    col2/col3 are non-negative integers.
    "loci"        : just verify the file is non-empty and readable.

    Raises SystemExit with a clear message on validation failure.
    """
    p = Path(input_path)
    if not p.exists():
        sys.exit(f"Error: --input-file not found: {input_path}")
    if p.stat().st_size == 0:
        sys.exit(f"Error: --input-file is empty: {input_path}")

    # Open .gz transparently
    import gzip
    opener = gzip.open if str(p).endswith(".gz") else open
    try:
        with opener(p, "rt") as fh:
            first = None
            for line in fh:
                line = line.rstrip("\n")
                if not line or line.startswith("#"):
                    continue
                first = line
                break
    except OSError as e:
        sys.exit(f"Error: cannot read --input-file: {e}")

    if first is None:
        sys.exit(f"Error: --input-file has no data rows: {input_path}")

    if fmt == "tsv_geneids":
        cols = first.split("\t")
        if not cols[0].strip():
            sys.exit(
                f"Error: first column of {input_path} is empty (expected gene IDs)."
            )
    elif fmt == "bed":
        cols = first.split("\t")
        if len(cols) < 3:
            sys.exit(
                f"Error: {input_path} doesn't look like BED — expected ≥3 "
                f"tab-separated columns, got {len(cols)}."
            )
        try:
            start = int(cols[1])
            end = int(cols[2])
        except ValueError:
            # Could be a header row; let snakemake's has_header handle it
            return
        if start < 0 or end < start:
            sys.exit(
                f"Error: {input_path} BED coordinates look wrong on the "
                f"first data row (start={cols[1]}, end={cols[2]})."
            )
    elif fmt == "loci":
        # ShortStack accepts gff3, bed, or simple chr:start-end; just confirm readability
        return
    else:
        sys.exit(f"Internal error: unknown input format '{fmt}'")


def cmd_output(args, extra_args):
    """Run snakemake on a single user-targeted plot/output."""
    repo = find_repo_root()
    os.chdir(repo)

    spec = OUTPUT_TYPES[args.plot_type]

    # --- Resolve label
    label = args.plot_label or derive_label_from_filename(args.input_file)
    # Strip any path components and disallow path separators
    if "/" in label or "\\" in label or label.startswith("-"):
        sys.exit(
            f"Error: --plot-label must be a plain identifier (no path "
            f"separators, no leading dash): got '{label}'"
        )

    # --- Validate input file format
    validate_output_input(args.input_file, spec["format"])

    # --- Load options to resolve analysis_name / output_dir defaults
    try:
        import yaml
    except ImportError:
        sys.exit("Error: PyYAML not available. Activate the epicc conda environment.")
    if not Path(args.options).exists():
        sys.exit(f"Error: Options file not found: {args.options}")
    with open(args.options) as f:
        cfg = yaml.safe_load(f) or {}

    analysis_name = args.analysis_name or cfg.get("analysis_name") or "epicc"
    output_dir = args.output_dir or cfg.get("output_dir", "results")
    ref_genome = args.ref_genome
    env = args.env
    matrix = args.matrix or "regions"

    # --- Required-arg gating per type
    for need in spec["needs"]:
        if not getattr(args, need.replace("-", "_"), None):
            sys.exit(
                f"Error: --{need.replace('_', '-')} is required for "
                f"--plot-type {args.plot_type}."
            )
    if "env" in spec["needs"] and env not in VALID_OUTPUT_ENVS:
        sys.exit(
            f"Error: --env {env!r} is not one of "
            f"{', '.join(VALID_OUTPUT_ENVS)}."
        )
    if matrix not in VALID_OUTPUT_MATRICES:
        sys.exit(
            f"Error: --matrix {matrix!r} is not one of "
            f"{', '.join(VALID_OUTPUT_MATRICES)}."
        )

    # --- Build target path
    target = spec["target"].format(
        output_dir=output_dir,
        analysis_name=analysis_name,
        ref_genome=ref_genome or "",
        env=env or "",
        label=label,
        matrix=matrix,
    )

    # --- Build snakemake config overrides for the target's input wiring
    sources = {
        "input_file": args.input_file,
        "label": label,
        "ref_genome": ref_genome or "",
    }
    config_overrides = []
    for cfg_key, source in spec["inputs"]:
        config_overrides.append(f"{cfg_key}={sources[source]}")
    if args.analysis_name:
        config_overrides.append(f"analysis_name={analysis_name}")

    # --- Build snakemake command (re-uses the same execution-mode logic)
    cmd = ["snakemake"]
    if not Path(args.options).exists():
        sys.exit(f"Error: Options file not found: {args.options}")
    cmd += ["--configfile", args.options]
    workflow_profile = getattr(args, "workflow_profile", None) or str(
        repo / DEFAULT_WORKFLOW_PROFILE
    )
    if Path(workflow_profile).is_dir():
        cmd += ["--workflow-profile", workflow_profile]
    profile, cores = detect_execution_mode(args)
    if profile:
        cmd += ["--profile", profile]
    else:
        cmd += ["--use-conda", "--conda-frontend", "conda", "--cores", str(cores)]
    if args.samples:
        if not Path(args.samples).exists():
            sys.exit(f"Error: Sample file not found: {args.samples}")
        config_overrides.append(f"sample_file={args.samples}")
    if args.output_dir:
        config_overrides.append(f"output_dir={args.output_dir}")
    if args.genome_dir:
        config_overrides.append(f"genome_dir={args.genome_dir}")
    if config_overrides:
        cmd += ["--config"] + config_overrides
    cmd.append("--rerun-incomplete")
    if args.verbose:
        cmd.append("--printshellcmds")
    if args.quiet:
        cmd.append("--quiet")
    if args.dry_run:
        cmd.append("--dry-run")
    if extra_args:
        cmd += extra_args
    # Use -- separator to prevent Snakemake from interpreting the target as an option
    cmd.append("--")
    cmd.append(target)

    print(f"EPICC: Targeting output → {target}", file=sys.stderr)
    if args.verbose:
        print(f"  Command: {' '.join(cmd)}", file=sys.stderr)

    result = subprocess.run(cmd)
    return result.returncode


def cmd_perf(args, extra_args):
    """Generate an execution timing report from a pipeline run's logs."""
    repo = find_repo_root()
    os.chdir(repo)

    profiler = repo / "dev" / "profile_snakemake_log.py"
    if not profiler.exists():
        sys.exit(f"Error: Profiler script not found: {profiler}")

    cmd = [sys.executable, str(profiler)]

    if args.logfile:
        cmd.append(args.logfile)
    elif args.single:
        cmd.append("--single")

    if args.html:
        cmd += ["--html", args.html]

    if args.multi:
        cmd += ["--multi"] + args.multi

    result = subprocess.run(cmd)
    return result.returncode


def cmd_unlock(args, extra_args):
    """Unlock the working directory after a failed or interrupted run."""
    repo = find_repo_root()
    os.chdir(repo)

    print("EPICC: Unlocking working directory...", file=sys.stderr)
    result = subprocess.run(["snakemake", "--unlock"])
    if result.returncode == 0:
        print("EPICC: Unlock complete.", file=sys.stderr)
    else:
        print(f"EPICC: Unlock failed (exit code {result.returncode}).",
              file=sys.stderr)
    return result.returncode


def cmd_clean(args, extra_args):
    """Selective cleanup of pipeline artifacts."""
    repo = find_repo_root()
    os.chdir(repo)

    if not any([args.intermediates, args.conda_envs, args.logs, args.all]):
        print("Nothing to clean. Specify --intermediates, --conda-envs, "
              "--logs, or --all.", file=sys.stderr)
        return 1

    if args.logs or args.all:
        log_dir = repo / ".snakemake" / "log"
        if log_dir.exists():
            logs = list(log_dir.glob("*.snakemake.log"))
            if len(logs) > 1:
                # Keep the most recent, remove the rest
                logs.sort(key=lambda p: p.stat().st_mtime)
                old_logs = logs[:-1]
                print(f"Removing {len(old_logs)} old log file(s) "
                      f"(keeping most recent)...", file=sys.stderr)
                for log in old_logs:
                    log.unlink()
            else:
                print("No old logs to clean.", file=sys.stderr)

    if args.conda_envs or args.all:
        print("Cleaning unused conda environments...", file=sys.stderr)
        result = subprocess.run(
            ["snakemake", "--sdm", "conda", "--conda-cleanup-envs"],
            capture_output=True, text=True,
        )
        if result.returncode == 0:
            print("  Done.", file=sys.stderr)
        else:
            print(f"  Failed: {result.stderr.strip()}", file=sys.stderr)

    if args.intermediates or args.all:
        # Delete checkpoint files to force reanalysis
        output_dir = args.output_dir or "results"
        chkpt_dirs = list(repo.glob(f"{output_dir}/*/chkpts"))
        if chkpt_dirs:
            print(f"Removing checkpoint files from {len(chkpt_dirs)} "
                  f"environment(s)...", file=sys.stderr)
            for d in chkpt_dirs:
                for f in d.iterdir():
                    f.unlink()
            print("  Done. Re-run the pipeline to regenerate analysis.",
                  file=sys.stderr)
        else:
            print("No checkpoint files found.", file=sys.stderr)

    return 0


# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

def add_common_options(parser):
    """Add options shared by run/validate."""
    parser.add_argument(
        "--options", default=DEFAULT_OPTIONS, metavar="FILE",
        help=f"Path to options YAML file (default: {DEFAULT_OPTIONS})",
    )
    parser.add_argument(
        "--samples", metavar="FILE",
        help="Path to sample sheet TSV (overrides options file value)",
    )
    parser.add_argument(
        "--cores", type=int, metavar="N",
        help="Cores for local execution (default: auto, half of nproc)",
    )
    parser.add_argument(
        "--profile", metavar="DIR",
        help=f"Cluster (execution) profile directory with executor and "
             f"site-specific settings (default: auto-detect; uses "
             f"{DEFAULT_PROFILE} if sbatch is available)",
    )
    parser.add_argument(
        "--workflow-profile", metavar="DIR",
        help=f"Workflow profile directory with per-rule resources/threads "
             f"(default: {DEFAULT_WORKFLOW_PROFILE})",
    )
    parser.add_argument(
        "--output-dir", metavar="DIR",
        help="Output directory prefix (default: results)",
    )
    parser.add_argument(
        "--genome-dir", metavar="DIR",
        help="Genome directory prefix (default: genomes)",
    )
    parser.add_argument(
        "--keep-intermediates", metavar="TIER",
        choices=["none", "standard", "custom", "all"],
        help="Intermediate file retention tier (none/standard/custom/all)",
    )
    verbosity = parser.add_mutually_exclusive_group()
    verbosity.add_argument(
        "--verbose", "-v", action="store_true",
        help="Verbose output (print shell commands)",
    )
    verbosity.add_argument(
        "--quiet", "-q", action="store_true",
        help="Minimal output",
    )


def add_run_options(parser):
    """Add options specific to run."""
    parser.add_argument(
        "--target", metavar="TARGET",
        help="Named target (default: all)",
    )
    parser.add_argument(
        "--until", metavar="RULE",
        help="Stop after this rule completes",
    )
    parser.add_argument(
        "--forcerun", nargs="+", metavar="RULE",
        help="Force re-execution of specific rules",
    )
    parser.add_argument(
        "--no-auto-unlock", action="store_true",
        help="Don't auto-unlock the working directory if a stale Snakemake "
             "lock is detected at startup (default: auto-unlock with notice)",
    )


def add_graph_options(parser):
    """Add --dag / --rulegraph file outputs.

    Format is inferred from the file extension (.png/.svg/.pdf via graphviz
    ``dot``; .dot writes raw dot text). Available on validate.
    """
    parser.add_argument(
        "--dag", metavar="FILE",
        help="Render the per-job DAG to FILE (format from extension: "
             "png/svg/pdf/dot). Requires graphviz 'dot' for non-dot formats.",
    )
    parser.add_argument(
        "--rulegraph", metavar="FILE",
        help="Render the rule-level graph to FILE (format from extension).",
    )


def build_parser():
    """Build the argument parser with subcommands."""
    parser = argparse.ArgumentParser(
        prog="epicc",
        description=DESCRIPTION,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    # --- run ---
    p_run = subparsers.add_parser(
        "run", help="Execute the pipeline",
        description="Run the EPICC pipeline. Arguments after -- are passed "
                    "directly to snakemake.",
    )
    add_common_options(p_run)
    add_run_options(p_run)

    # --- validate ---
    p_val = subparsers.add_parser(
        "validate", help="Validate configuration",
        description="Check the options file and sample sheet for errors, "
                    "then run a snakemake dry-run for full DAG validation.",
    )
    add_common_options(p_val)
    add_graph_options(p_val)

    # --- output ---
    p_out = subparsers.add_parser(
        "output", help="Generate a single targeted output (plot/GO/clusters/browser)",
        description="Run a single, user-targeted output type against a "
                    "supplied input file. Available types: "
                    + ", ".join(OUTPUT_TYPES.keys()) + ".",
    )
    add_common_options(p_out)
    p_out.add_argument(
        "--plot-type", required=True, choices=sorted(OUTPUT_TYPES.keys()),
        help="Output product to generate.",
    )
    p_out.add_argument(
        "--input-file", required=True, metavar="PATH",
        help="Input data file for the target output (gene list, BED, "
             "GFF/loci file). Format is validated per --plot-type.",
    )
    p_out.add_argument(
        "--plot-label", metavar="LABEL",
        help="Label embedded in output filenames. Defaults to the input "
             "file's basename without extension.",
    )
    p_out.add_argument(
        "--analysis-name", metavar="NAME",
        help="Override analysis_name from the options file.",
    )
    p_out.add_argument(
        "--ref-genome", metavar="GENOME",
        help="Reference genome name (must match a genome configured in "
             "the options file). Required for most plot types.",
    )
    p_out.add_argument(
        "--env", metavar="ENV", choices=VALID_OUTPUT_ENVS,
        help="Data type for env-aware plots (heatmap/metaplot/browser): "
             + ", ".join(VALID_OUTPUT_ENVS) + ".",
    )
    p_out.add_argument(
        "--matrix", metavar="KIND", choices=VALID_OUTPUT_MATRICES,
        default="regions",
        help="Matrix layout for heatmap/metaplot: regions (whole feature), "
             "tss, or tes. Default: regions.",
    )
    p_out.add_argument(
        "--dry-run", action="store_true",
        help="Resolve and print the snakemake plan without running.",
    )

    # --- perf ---
    p_perf = subparsers.add_parser(
        "perf", help="Profile pipeline performance",
        description="Generate an execution timing report from snakemake log "
                    "files. By default, all logs from the most recent resumed "
                    "run are aggregated. Wraps dev/profile_snakemake_log.py.",
    )
    p_perf.add_argument(
        "logfile", nargs="?",
        help="Path to a specific .snakemake.log file "
             "(default: aggregate latest run)",
    )
    p_perf.add_argument(
        "--single", action="store_true",
        help="Profile only the newest single log, without aggregating",
    )
    p_perf.add_argument(
        "--html", metavar="FILE",
        help="Write HTML report to FILE",
    )
    p_perf.add_argument(
        "--multi", nargs="+", metavar="LABEL=LOG",
        help="Generate multi-section HTML: 'Label=path/to/log' ...",
    )

    # --- unlock ---
    subparsers.add_parser(
        "unlock", help="Unlock the working directory",
        description="Remove Snakemake's directory lock after a failed or "
                    "interrupted run. Equivalent to 'snakemake --unlock'.",
    )

    # --- clean ---
    p_clean = subparsers.add_parser(
        "clean", help="Clean pipeline artifacts",
        description="Selectively remove pipeline artifacts like old logs, "
                    "unused conda environments, and checkpoint files.",
    )
    p_clean.add_argument(
        "--output-dir", metavar="DIR",
        help="Output directory to clean (default: results)",
    )
    p_clean.add_argument(
        "--intermediates", action="store_true",
        help="Remove checkpoint files (forces reanalysis on next run)",
    )
    p_clean.add_argument(
        "--conda-envs", action="store_true",
        help="Remove unused conda environments",
    )
    p_clean.add_argument(
        "--logs", action="store_true",
        help="Remove old snakemake log files (keeps most recent)",
    )
    p_clean.add_argument(
        "--all", action="store_true",
        help="All of the above",
    )

    return parser


def main():
    parser = build_parser()

    # Split args at -- to separate epicc args from snakemake passthrough
    argv = sys.argv[1:]
    if "--" in argv:
        split_idx = argv.index("--")
        epicc_args = argv[:split_idx]
        extra_args = argv[split_idx + 1:]
    else:
        epicc_args = argv
        extra_args = []

    args = parser.parse_args(epicc_args)

    dispatch = {
        "run": cmd_run,
        "validate": cmd_validate,
        "output": cmd_output,
        "unlock": cmd_unlock,
        "perf": cmd_perf,
        "clean": cmd_clean,
    }

    handler = dispatch.get(args.command)
    if handler is None:
        parser.print_help()
        return 1

    return handler(args, extra_args)


if __name__ == "__main__":
    sys.exit(main())
