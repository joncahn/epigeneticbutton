def find_repo_root():
    """Find the repository root (directory containing workflow/Snakefile)."""
    # Start from the script's own location
    script_dir = Path(__file__).resolve().parent
    if (script_dir / "workflow" / "Snakefile").exists():
        return script_dir
    # Fall back to cwd
    cwd = Path.cwd()
    if (cwd / "workflow" / "Snakefile").exists():
        return cwd
    sys.exit(
        "Error: Cannot find EPICC pipeline (workflow/Snakefile).\n"
        "Run this command from the pipeline directory, or ensure the epicc "
        "script is located at the repository root."
    )


def is_url(path):
    """Return True if the string looks like an HTTP(S) URL."""
    return isinstance(path, str) and (
        path.startswith("http://") or path.startswith("https://")
    )


def url_resolves(url, timeout=10):
    """Check whether an HTTP(S) URL resolves. Returns (ok, detail).

    Uses a ranged GET (bytes=0-0) rather than HEAD because some hosts (e.g.
    CDN-fronted downloads) mishandle HEAD. Follows redirects via urllib's
    default opener.
    """
    import urllib.error
    import urllib.request
    req = urllib.request.Request(url, headers={"Range": "bytes=0-0"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            code = resp.getcode()
            return code < 400, f"HTTP {code}"
    except urllib.error.HTTPError as e:
        return False, f"HTTP {e.code}"
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        return False, str(e)


def fmt_duration(seconds):
    """Format seconds as human-readable duration."""
    if seconds < 60:
        return f"{seconds:.0f}s"
    elif seconds < 3600:
        m, s = divmod(seconds, 60)
        return f"{int(m)}m {int(s)}s"
    else:
        h, rem = divmod(seconds, 3600)
        m, _ = divmod(rem, 60)
        return f"{int(h)}h {int(m)}m"


# Snakemake graph flags: (cli_kind, snakemake_flag)
GRAPH_KINDS = (("dag", "--dag"), ("rulegraph", "--rulegraph"))


def render_graph(args, kind, snakemake_flag, output_path):
    """Run `snakemake <flag>` and render its dot output to a file.

    Output format is inferred from ``output_path``'s extension.  ``.dot``
    writes the raw dot text; everything else is piped through graphviz
    ``dot -T<fmt>`` (png/svg/pdf/...). Requires the ``dot`` executable on PATH
    for non-``.dot`` outputs.
    """
    import shutil as _shutil

    out = Path(output_path)
    fmt = out.suffix.lstrip(".").lower() or "png"

    cmd = ["snakemake", snakemake_flag,
           "--configfile", args.options,
           "--cores", "1", "--quiet", "all"]
    # Honor the same workflow profile and config overrides as the run.
    repo = find_repo_root()
    workflow_profile = getattr(args, "workflow_profile", None) or str(
        repo / DEFAULT_WORKFLOW_PROFILE
    )
    if Path(workflow_profile).is_dir():
        cmd += ["--workflow-profile", workflow_profile]
    overrides = []
    if getattr(args, "samples", None):
        overrides.append(f"sample_file={args.samples}")
    if getattr(args, "output_dir", None):
        overrides.append(f"output_dir={args.output_dir}")
    if getattr(args, "genome_dir", None):
        overrides.append(f"genome_dir={args.genome_dir}")
    if overrides:
        cmd += ["--config"] + overrides

    print(f"EPICC: Generating {kind} → {out}", file=sys.stderr)
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr)
        return proc.returncode
    dot_text = proc.stdout

    if fmt == "dot":
        out.write_text(dot_text)
        return 0
    if not _shutil.which("dot"):
        sys.exit(
            f"Error: graphviz 'dot' not found on PATH (needed to render "
            f"{out}). Install graphviz, or output a .dot file instead."
        )
    render = subprocess.run(
        ["dot", f"-T{fmt}", "-o", str(out)],
        input=dot_text, text=True, capture_output=True,
    )
    if render.returncode != 0:
        sys.stderr.write(render.stderr)
    return render.returncode


def maybe_render_graphs(args):
    """If --dag or --rulegraph was requested, render and return True.

    Returns the number of graph files successfully written (0 if none asked).
    Caller decides whether to short-circuit downstream work.
    """
    written = 0
    for kind, flag in GRAPH_KINDS:
        out = getattr(args, kind, None)
        if not out:
            continue
        rc = render_graph(args, kind, flag, out)
        if rc != 0:
            sys.exit(rc)
        written += 1
    return written


def maybe_clear_stale_lock(args, repo):
    """Auto-unlock the working directory if a stale Snakemake lock is found.

    Killed runs (SLURM timeouts, Ctrl-C, node failures) leave files in
    `.snakemake/locks/` that block subsequent invocations until manually
    cleared. We can't reliably detect a *live* concurrent coordinator in a
    cluster environment (it could be on any node, and the lock files contain
    no PID/host info), so we just clear non-empty locks with a visible notice.
    Pass --no-auto-unlock to disable this behavior.
    """
    if getattr(args, "no_auto_unlock", False):
        return
    locks = repo / ".snakemake" / "locks"
    if not locks.exists() or not any(locks.iterdir()):
        return
    print("EPICC: Detected stale Snakemake lock from a prior run; unlocking.",
          file=sys.stderr)
    subprocess.run(
        ["snakemake", "--unlock", "--configfile", args.options],
        cwd=str(repo), check=False,
    )


_PLACEHOLDER_RE = __import__("re").compile(r"<your-[a-z0-9-]+>", __import__("re").IGNORECASE)


def check_profile_placeholders(profile_arg):
    """Fail fast if the user's profile still ships an unedited placeholder.

    profiles/slurm/config.yaml ships `slurm_account="<your-slurm-account>"`
    as the default. Without this check, sbatch silently rejects every job
    submitted under that account name and the run hangs at
    "Select jobs to execute..." with nothing visible in `squeue` — a
    debugging trap (see e.g. github.com/joncahn/epigeneticbutton/issues/...
    for the original report). Surface the unedited value upfront with a
    pointer back at the offending file so the user knows exactly what to
    fix.

    `profile_arg` is whatever the user passed to --profile (a directory
    or a config.yaml path); this resolves either to the actual config
    file before scanning.
    """
    if not profile_arg:
        return
    repo = find_repo_root()
    candidate = Path(profile_arg)
    if not candidate.is_absolute():
        candidate = (repo / candidate).resolve()
    if candidate.is_dir():
        config_path = candidate / "config.yaml"
    else:
        config_path = candidate
    if not config_path.exists():
        return  # snakemake will report the missing-profile error itself
    text = config_path.read_text()
    placeholders = sorted(set(_PLACEHOLDER_RE.findall(text)))
    if not placeholders:
        return
    print(
        "EPICC: profile contains unedited placeholder value(s):",
        file=sys.stderr,
    )
    for ph in placeholders:
        print(f"    {ph}", file=sys.stderr)
    print(
        f"  in: {config_path}\n"
        "  Edit that file to fill in the real value(s) for your cluster, "
        "or remove the offending lines if not applicable. Without this fix, "
        "sbatch will silently reject every job and the run will hang at "
        "'Select jobs to execute...' with nothing in the queue.",
        file=sys.stderr,
    )
    sys.exit(2)


def detect_execution_mode(args):
    """Determine whether to use a SLURM profile or local cores.

    Returns (profile_path, cores) — one will be None.
    """
    if args.profile:
        return args.profile, None
    if args.cores:
        return None, args.cores

    # Auto-detect: SLURM if sbatch is available
    if shutil.which("sbatch"):
        profile = DEFAULT_PROFILE
        repo = find_repo_root()
        if not (repo / profile / "config.yaml").exists():
            print(f"Warning: sbatch found but {profile}/config.yaml missing; "
                  f"falling back to local execution.", file=sys.stderr)
            cores = max(1, os.cpu_count() // 2)
            return None, cores
        return profile, None

    cores = max(1, os.cpu_count() // 2)
    return None, cores


def build_snakemake_cmd(args, extra_args, *, dry_run=False):
    """Construct the snakemake command line from parsed arguments."""
    repo = find_repo_root()

    cmd = ["snakemake"]

    # Options file
    options_file = args.options
    if not Path(options_file).exists():
        sys.exit(f"Error: Options file not found: {options_file}")
    cmd += ["--configfile", options_file]

    # Workflow profile — per-rule resource and thread tuning. Ships with the
    # repo; users normally should not edit it. Override with --workflow-profile.
    workflow_profile = getattr(args, "workflow_profile", None) or str(
        repo / DEFAULT_WORKFLOW_PROFILE
    )
    if Path(workflow_profile).is_dir():
        cmd += ["--workflow-profile", workflow_profile]

    # Execution mode
    profile, cores = detect_execution_mode(args)
    if profile:
        cmd += ["--profile", profile]
    else:
        cmd += ["--use-conda", "--conda-frontend", "conda", "--cores", str(cores)]

    # Config overrides via --config key=value
    config_overrides = []
    if args.samples:
        if not Path(args.samples).exists():
            sys.exit(f"Error: Sample file not found: {args.samples}")
        config_overrides.append(f"sample_file={args.samples}")
    # Common options (always present via add_common_options)
    if args.output_dir:
        config_overrides.append(f"output_dir={args.output_dir}")
    if args.genome_dir:
        config_overrides.append(f"genome_dir={args.genome_dir}")
    if args.keep_intermediates:
        config_overrides.append(f"keep_intermediates={args.keep_intermediates}")
    if config_overrides:
        cmd += ["--config"] + config_overrides

    # Dry-run
    if dry_run:
        cmd.append("--dry-run")

    # Re-run any jobs Snakemake marked incomplete on a prior interrupted run.
    # Without this, Snakemake errors out on the first affected rule, which is
    # almost never what the user wants when resuming.
    cmd.append("--rerun-incomplete")

    # Verbosity
    if args.verbose:
        cmd.append("--printshellcmds")
    if args.quiet:
        cmd.append("--quiet")

    # Subcommand-specific options
    if hasattr(args, 'target') and args.target:
        cmd.append(args.target)
    if hasattr(args, 'until') and args.until:
        cmd += ["--until", args.until]
    if hasattr(args, 'forcerun') and args.forcerun:
        cmd += ["--forcerun"] + args.forcerun

    # Passthrough arguments (everything after --)
    if extra_args:
        cmd += extra_args

    return cmd


