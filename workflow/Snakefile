# ---------------------------------------------------------------------------
# Read and validate sample sheet (new format)
# ---------------------------------------------------------------------------
# `snakemake --unlock` only removes lock files, but it still parses the whole
# workflow first — so it would otherwise trip the no-sample-sheet guard below.
# Unlocking needs no sample sheet, so when unlocking we build an empty one,
# which lets the rule modules parse (their module-level sample lookups are
# empty-safe) and skip sample validation entirely.
UNLOCKING = "--unlock" in sys.argv

if not config.get("sample_file"):
    if not UNLOCKING:
        sys.exit(
            "Error: No sample sheet specified. Set `sample_file:` in your options "
            "YAML or pass --config sample_file=PATH (or use `epicc run --samples "
            "PATH`). See config/example_samples.tsv for a documented template."
        )
    samples = add_compat_columns(
        pd.DataFrame({c: pd.Series(dtype=str) for c in NEW_COLNAMES})
    )
else:
    samples = read_sample_sheet(config["sample_file"])
    check_table(samples)
    check_genome_config(samples, config, repo_folder=REPO_FOLDER)
    check_extra_output_files(config, repo_folder=REPO_FOLDER)

    # Add backward-compatible columns derived from new-format fields
    samples = add_compat_columns(samples)

# Check for unknown envs
unknowns = samples.loc[samples["env"].isna(), "Assay"].unique()
if len(unknowns) > 0:
    unknown_list = "\n".join(f"  - {a}" for a in unknowns)
    raise ValueError(f"Unknown Assay types:\n{unknown_list}\n\n"
                     "Please check your sample file. Valid assays: " + ", ".join(VALID_ASSAYS))

# Define reference genomes, data types and environments
