# Intro message
def print_to_tty_or_stdout(msg, color=None):
    colors = {
        "green": "\033[92m",
        "red": "\033[91m",
        "reset": "\033[0m"
    }
    color_code = colors.get(color, "")
    reset_code = colors["reset"] if color else ""
    try:
        with open("/dev/tty", "w") as tty:
            print(f"{color_code}{msg}{reset_code}", file=tty)
    except OSError:
        print(msg)
        
def print_banner():
    banner_lines = [
        "You just pushed the epigenetic button!",
        "It is going to be..."
    ]
    
    try:
        with open("data/banner.txt") as f:
            banner_lines.extend(f.read().splitlines())
    except FileNotFoundError:
        pass

    for line in banner_lines:
        print_to_tty_or_stdout(line, color="green")

try:
    with open("/dev/tty", "w") as tty:
        print_banner()
except OSError:
    pass

