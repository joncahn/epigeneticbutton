# Intro message
def print_to_tty_or_stdout(msg, color=None):
    colors = {
        "green": "\033[92m",
        "red": "\033[91m",
        "reset": "\033[0m"
    }
    color_code = colors.get(color, "")
    reset_code = colors["reset"] if color else ""
    try:
        with open("/dev/tty", "w") as tty:
            print(f"{color_code}{msg}{reset_code}", file=tty)
    except OSError:
        print(msg)
        
def print_banner():
    banner_lines = [
        "You just pushed the epigenetic button!",
        "It is going to be..."
    ]
    
    try:
        with open(resolve_repo_data("data/banner.txt")) as f:
            banner_lines.extend(f.read().splitlines())
    except FileNotFoundError:
        pass

    for line in banner_lines:
        print_to_tty_or_stdout(line, color="green")

# The banner ("you pushed the epigenetic button") is printed from the
# `onstart` handler below, not here at parse time. Snakemake only fires
# `onstart` when a run actually begins executing jobs — never on dry-run,
# unlock, --dag, --list, env pre-build, and the like. That keeps the banner
# tied to a genuine run without having to enumerate every administrative
# invocation that merely parses the workflow.

# Configuration — default options ship alongside the workflow. Anchor to
# workflow.basedir (the Snakefile's dir) rather than the CWD so the base
# config loads in both git-clone (<repo>/config/) and installed
# ($PREFIX/share/epicc/config/) layouts. A user --configfile overrides it.
configfile: os.path.join(workflow.basedir, "..", "config", "epicc-options.yaml")
