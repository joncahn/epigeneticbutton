# Rule all to specify final target
rule all:
    input:
	    expand(f"{RESULTS_DIR}/combined/chkpts/final_analysis__{analysis_name}.done", analysis_name = analysis_name)
    localrule: True

### Intermediate target rules
# Rule to specify final target if only mapping is required

rule map_only:
    input: all_map_only_input
    localrule: True

# Rule to specify final target if only chip coverage is wanted
rule coverage_chip:
    input: 
        [
            f"{RESULTS_DIR}/ChIP/tracks/coverage__{sample_name}.bw"
            for sample_name in get_sample_names_by_env("ChIP", samples)
        ]
    localrule: True

# Rule to perform combined analysis
rule combined_analysis:
    input:
        expand(f"{RESULTS_DIR}/combined/chkpts/combined_analysis__{{analysis_name}}__{{ref_genome}}.done", analysis_name = analysis_name, ref_genome=REF_GENOMES),
        expand(f"{RESULTS_DIR}/ChIP/chkpts/ChIP_analysis__{{analysis_name}}__{{ref_genome}}.done", analysis_name = analysis_name, ref_genome=REF_GENOMES if "ChIP" in UNIQUE_ENVS else []),
        expand(f"{RESULTS_DIR}/RNA/chkpts/RNA_analysis__{{analysis_name}}__{{ref_genome}}.done", analysis_name = analysis_name, ref_genome=REF_GENOMES if "RNA" in UNIQUE_ENVS else []),
        expand(f"{RESULTS_DIR}/mC/chkpts/mC_analysis__{{analysis_name}}__{{ref_genome}}.done", analysis_name = analysis_name, ref_genome=REF_GENOMES if "mC" in UNIQUE_ENVS else []),
        expand(f"{RESULTS_DIR}/sRNA/chkpts/sRNA_analysis__{{analysis_name}}__{{ref_genome}}.done", analysis_name = analysis_name, ref_genome=REF_GENOMES if "sRNA" in UNIQUE_ENVS else []),
        expand(f"{RESULTS_DIR}/ATAC/chkpts/ATAC_analysis__{{analysis_name}}__{{ref_genome}}.done", analysis_name = analysis_name, ref_genome=REF_GENOMES if "ATAC" in UNIQUE_ENVS else [])
    output:
        chkpt = f"{RESULTS_DIR}/combined/chkpts/final_analysis__{analysis_name}.done"
    localrule: True
    shell:
        """
        touch {output.chkpt}
        """ 

# Start message — fires only when a run actually begins executing jobs, so the
# banner never appears on dry-run/unlock/--dag/--list/env-build invocations.
onstart:
    print_banner()

# Exit message
onsuccess:
    elapsed = time.time() - _start
    h, m = divmod(elapsed / 3600, 1)
    m = int(m * 60)
    print_to_tty_or_stdout(
        f"EPICC SUCCESS! Pipeline completed successfully in {int(h)}h {m}m.", 
        color="green"
    )

onerror:
    elapsed = time.time() - _start
    h, m = divmod(elapsed / 3600, 1)
    m = int(m * 60)
    print_to_tty_or_stdout(
        f"EPICC FAIL! Pipeline failed after {int(h)}h {m}m. Check logs!", 
        color="red"
    )

