if not os.path.isdir(REPO_FOLDER):
    raise FileNotFoundError(f"Repository folder not found: {REPO_FOLDER}\nUpdate the options file!")


def resolve_repo_data(path):
    """Resolve a bundled-data path against REPO_FOLDER (installed-mode aware).

    Thin wrapper over samplefile_validation.resolve_data_path so the workflow
    and the config validators share one resolution rule. See that function for
    semantics. Generic by design: any path under REPO_FOLDER resolves, so new
    files dropped into ``data/`` need no special-casing.
    """
    return resolve_data_path(path, REPO_FOLDER)

